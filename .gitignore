# ---------------------------------------------------------------------------
# TrailCut .gitignore: only source, config, docs and fixtures belong in git.
# tests/test_repo_policy.py checks the privacy-critical entries stay here.
# ---------------------------------------------------------------------------

# Privacy: user statements must never be committed (CLAUDE.md rule 4)
*.pdf
!tests/fixtures/**/synthetic_*.pdf

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# App caches and local data (public AMFI files, never user data, but not source)
.cache/
*.sqlite
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# Node / web
node_modules/
apps/web/dist/
apps/web/coverage/
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
.vite/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Eval run outputs
evals/results/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Claude local settings
.claude/settings.local.json
